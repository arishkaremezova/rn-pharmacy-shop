{
  "expo": {
    "name": "Моя аптека",
    "slug": "pharmacy-shop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pharmacy-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f2f7f4",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kord228.pharmacyshop",
      "adaptiveIcon": {
        "foregroundImage": "./assets/pharmacy-icon.png",
        "backgroundColor": "#f2f7f4"
      }
    },
    "splash": {
      "image": "./assets/pharmacy-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f2f7f4"
    },
    "web": {
      "favicon": "./assets/pharmacy-icon.png"
    },
    "scheme": "pharmacyshop",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
